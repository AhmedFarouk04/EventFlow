{
  "ConnectionStrings": {
    "Reservations": "Server=(localdb)\\mssqllocaldb;Database=EventDrivenBookingDB;Trusted_Connection=True;MultipleActiveResultSets=true",
    "Availability": "Server=(localdb)\\mssqllocaldb;Database=EventDrivenBookingAvailabilityDb;Trusted_Connection=True;MultipleActiveResultSets=true",
    "Audit": "Server=(localdb)\\mssqllocaldb;Database=EventDrivenBookingAuditDb;Trusted_Connection=True;MultipleActiveResultSets=true",
    "Pricing": "Server=(localdb)\\mssqllocaldb;Database=EventDrivenBookingPricingDb;Trusted_Connection=True;MultipleActiveResultSets=true",
    "Notifications": "Server=(localdb)\\mssqllocaldb;Database=EventDrivenBookingNotificationsDb;Trusted_Connection=True;MultipleActiveResultSets=true",
    "Users": "Server=(localdb)\\mssqllocaldb;Database=EventDrivenBookingUsersDb;Trusted_Connection=True;MultipleActiveResultSets=true"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": "Information",
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] ({CorrelationId}) {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/reservations-.log",
          "rollingInterval": "Day",
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} {Level:u3}] ({CorrelationId}) {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "AllowedHosts": "*",
  "RabbitMq": {
    "HostName": "localhost",
    "Port": 5672,
    "VirtualHost": "/",
    "UserName": "guest",
    "Password": "guest",
    "ExchangeName": "EventDrivenBookingExchange",
    "ExchangeType": "direct",
    "QueueName": "ReservationsQueue",
    "DeadLetterExchangeName": "EventDrivenBookingExchange.dlx",
    "DeadLetterQueueName": "ReservationsQueue.dlq",
    "RetryCount": 5,
    "PrefetchCount": 20
  },
  "Outbox": {
    "PollIntervalSeconds": 5,
    "BatchSize": 50
  },
  "Jwt": {
    "SecretKey": "ChangeMe_AtLeast32CharsSecretKey!",
    "Issuer": "EventDrivenBookingPlatform",
    "Audience": "EventDrivenBookingPlatform.Client",
    "ExpirationMinutes": 60
  }
}
